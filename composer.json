{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "onelegstudios/laravel-refit",
  "description": "Refit the starter - Customize Laravel’s Livewire starter kit around your workflow.",
  "keywords": [
    "laravel",
    "onelegstudios",
    "laravel-refit"
  ],
  "homepage": "https://github.com/onelegstudios/laravel-refit",
  "license": "MIT",
  "authors": [
    {
      "name": "Oneleggedswede",
      "email": "oneleggedswede@onelegstudios.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/support": "^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.9",
    "laravel/pint": "^1.29",
    "laravel/pao": "^1.0",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.6||^5.0",
    "pestphp/pest-plugin-laravel": "^4.1||^5.0",
    "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
    "phpstan/extension-installer": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "Onelegstudios\\Refit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Onelegstudios\\Refit\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Factories\\": "workbench/database/factories/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "prepare": [
      "@php vendor/bin/testbench package:discover --ansi"
    ],
    "build": [
      "@php vendor/bin/testbench workbench:build --ansi"
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ],
    "starter-kits": [
      "@php bin/download-starter-kits.php"
    ],
    "lint": [
      "vendor/bin/pint --parallel"
    ],
    "lint:check": [
      "vendor/bin/pint --parallel --test"
    ],
    "analyse": [
      "vendor/bin/phpstan analyse"
    ],
    "test:types": [
      "vendor/bin/pest --type-coverage --min=100"
    ],
    "test:unit": [
      "vendor/bin/pest --parallel"
    ],
    "test": [
      "@analyse",
      "@lint:check",
      "@test:types",
      "@test:unit"
    ],
    "clear": [
      "@php vendor/bin/testbench package:purge-skeleton --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Onelegstudios\\Refit\\RefitServiceProvider"
      ],
      "aliases": {
        "Refit": "Onelegstudios\\Refit\\Facades\\Refit"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
